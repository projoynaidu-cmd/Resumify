# ─────────────────────────────────────────────────────────────
# Resumify — Environment Variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_NAME=Resumify
NEXT_PUBLIC_APP_URL=https://resumify.app

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/Resumify?schema=public"

# NextAuth
# Generate: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
AUTH_URL="https://resumify.app"

# Google OAuth
# Console: https://console.developers.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
# Settings: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Stripe (Production)
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# Create a recurring price in Stripe dashboard → Products → Add product
# Price ID looks like: price_1234abcd...
STRIPE_PRO_PRICE_ID="price_..."

# Anthropic Claude (AI Features)
# Dashboard: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# PostHog Analytics (optional)
# Dashboard: https://app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Resend email (optional)
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@resumify.app"

# Admin access (comma-separated emails)
ADMIN_EMAILS="you@resumify.app"
