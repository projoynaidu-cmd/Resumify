# ─────────────────────────────────────────────────────────────
# ResumeForge — Environment Variables
# Copy to .env.local and fill in. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_NAME=ResumeForge
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
# Local:   postgresql://user:password@localhost:5432/resumeforge
# Supabase: get from Project Settings → Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/resumeforge?schema=public"

# NextAuth
# Generate: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
AUTH_URL="http://localhost:3000"

# Google OAuth
# Console: https://console.developers.google.com
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth
# Settings: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Stripe (Phase 3)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Resend email (Phase 3)
# RESEND_API_KEY=""
# EMAIL_FROM="noreply@resumeforge.com"

# Stripe (Phase 3)
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Create a recurring price in Stripe dashboard → Products → Add product
# Price ID looks like: price_1234abcd...
STRIPE_PRO_PRICE_ID="price_..."

# Anthropic Claude (Phase 4 — AI Features)
# Dashboard: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."

# PostHog Analytics (Phase 7)
# Dashboard: https://app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Admin access (comma-separated emails)
ADMIN_EMAILS="you@example.com"

# Resend email (Phase 8)
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@yourdomain.com"

# Admin access (comma-separated emails)
ADMIN_EMAILS="you@yourdomain.com"

# PostHog analytics
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Email (Phase 8)
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@yourdomain.com"
